PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/hotel_dining
JWT_SECRET=change_this_to_a_long_random_string

# Admin dashboard (/dashboard) login.
# Generate ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$agHAxLoaf3h1NMqVmrspr.qPQAFNGJ.uFmM5H/ovl9tS0RU4F46DO

# Optional — enables Google Geocoding for reverse-geocoding "current location"
# addresses (more accurate than the free Nominatim fallback used without it).
# https://console.cloud.google.com/google/maps-apis/credentials — enable the
# "Geocoding API" for the key.
GOOGLE_GEOCODING_API_KEY=
